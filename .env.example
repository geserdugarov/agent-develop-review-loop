# Copy this file to .env in the target repository where you run
# develop-review-loop. The script reads ./.env from the current working
# directory, not from this tool repository, unless this repository is the target.

# Agent used for the implementation/fix stage. Supported: claude, codex.
# Extra stage-specific CLI flags may follow the agent name.
# If this variable is also exported in the shell, the exported value wins.
# Default: claude
DEV_AGENT=claude
# DEV_AGENT=codex -m gpt-5.5 -c 'model_reasoning_effort="xhigh"'

# Agent used for the review stage. Supported: claude, codex.
# Extra stage-specific CLI flags may follow the agent name.
# If this variable is also exported in the shell, the exported value wins.
# Default: codex
REVIEW_AGENT=codex
# REVIEW_AGENT=codex -m gpt-5.5 -c 'model_reasoning_effort="xhigh"'

# Path to the codex CLI. Override only if not on $PATH.
# If this variable is also exported in the shell, the exported value wins.
CODEX_BIN=codex

# Optional explicit Codex model. When set, passed to `codex exec -m` and used
# as the usage-summary fallback when Codex JSON logs omit the model name.
# Leave unset to use Codex's own default/configured model.
# CODEX_MODEL=gpt-5.5

# Optional extra Codex flags used for every Codex stage.
# CODEX_ARGS=-c 'model_reasoning_effort="xhigh"'

# Path to the claude CLI. Override only if not on $PATH.
# If this variable is also exported in the shell, the exported value wins.
CLAUDE_BIN=claude

# Optional explicit Claude model. Passed as `claude --model "$CLAUDE_MODEL"`.
# Leave unset to use Claude's own default/configured model.
# CLAUDE_MODEL=claude-opus-4-7

# Optional extra Claude flags used for every Claude stage.
# CLAUDE_ARGS="--effort xhigh"

# Number of run artifact subdirectories to keep under .develop-review-loop/.
# The current run counts toward this limit. Must be a positive integer.
# If this variable is also exported in the shell, the exported value wins.
# Default: 3
DEVELOP_REVIEW_LOOP_KEEP_RUNS=3
